theorem good4 : IsGoodExactColouring 4 4 4 328 col4 :=
  good_of_tests (m := 4) (D := 109) (by decide) (by decide) (by decide) (by decide) (by decide) cols4 (by
    intro d h1 h2
    by_cases c0 : d < 10
    · exact rangeTest_spec _ rows4_0 d (by omega) (by omega)
